@echo off
setlocal

set "PROJECT=%~dp0"
set "LOCAL_ROOT=C:\ai-webtoon-local-modules"
set "DEST=%LOCAL_ROOT%\reference-library"
set "SRC=%PROJECT%node_modules"

echo ================================================
echo  Setting up a local (non-Drive) folder for node_modules
echo  Source:      %SRC%
echo  Destination: %DEST%\node_modules
echo ================================================
echo.

dir "%SRC%" 2>nul | findstr /C:"JUNCTION" >nul
if not errorlevel 1 (
  echo Already linked as a junction. Nothing to do here.
  echo Just run npm install in this folder if you have not already.
  pause
  exit /b 0
)

if exist "%SRC%" (
  echo Removing the existing node_modules folder from the Google Drive folder...
  echo This is safe. It gets rebuilt by npm install in the last step.
  rmdir /s /q "%SRC%"
)

if not exist "%LOCAL_ROOT%" mkdir "%LOCAL_ROOT%"
if not exist "%DEST%" mkdir "%DEST%"
if not exist "%DEST%\node_modules" mkdir "%DEST%\node_modules"

echo Creating a junction so this folder still works like a normal node_modules...
mklink /J "%SRC%" "%DEST%\node_modules"

echo.
echo Result - node_modules should now show as a JUNCTION:
dir "%PROJECT%" | findstr /I "node_modules"
echo.
echo NEXT STEP: run "npm install" inside this reference-library folder now,
echo so the packages get installed into the new local folder.
echo.
pause
